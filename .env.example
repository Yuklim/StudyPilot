# Export this variable before backend commands; .env is not loaded automatically.
# Run in backend/: this relative URL stores data under backend/var/.
# Use an absolute SQLite URL if running commands from different directories.
STUDYPILOT_DATABASE_URL=sqlite:///./var/studypilot.db
# These ports define exact trusted authorities, not network binding/launch options.
# Start uvicorn with --host 127.0.0.1 --port 8000; one worker only.
STUDYPILOT_API_PORT=8000
STUDYPILOT_UI_PORT=5173
