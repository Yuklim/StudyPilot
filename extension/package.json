{
  "name": "studypilot-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest",
    "build": "npm run typecheck && vite build && vite build -c vite.injected.config.ts --mode extract && vite build -c vite.injected.config.ts --mode relay && vite build -c vite.injected.config.ts --mode background"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.1.28",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "defuddle": "0.19.3"
  }
}
